# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git (.gitignore).

# Chave HS256 do JWT (32+ caracteres). A API .NET usa a MESMA chave para validar o token.
# Vazio = chave aleatória a cada subida (tokens deixam de valer ao reiniciar).
JWT_SECRET=

# IA generativa (Spring AI, API compatível com OpenAI). Sem chave, o plano de contingência
# usa o plano padrão por regras e a leitura de etiqueta responde 503.
# Gemini (gratuito): https://aistudio.google.com/apikey
IA_API_KEY=
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_MODELO=gemini-3.8-flash
# OpenAI:  IA_BASE_URL=https://api.openai.com/v1   IA_MODELO=gpt-4o-mini
# Groq:    IA_BASE_URL=https://api.groq.com/openai/v1   IA_MODELO=meta-llama/llama-4-scout-17b-16e-instruct

# Banco (padrão: PostgreSQL do docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luzvital
DB_USER=luzvital
DB_PASSWORD=luzvital

# RabbitMQ (local, Docker ou CloudAMQP: amqps://usuario:senha@host/vhost)
RABBITMQ_ADDRESSES=amqp://guest:guest@localhost:5672

# Perfil Oracle (banco da disciplina): SPRING_PROFILES_ACTIVE=oracle
# ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
